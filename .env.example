# Copy this file to .env and fill in real values. Never commit .env itself.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=rizurf_employees
DB_USER=
DB_PASSWORD=

# This service, as the gateway knows it (MICROAPP_AUTH.md / RIZURF_API_TEMPLATE.md).
SERVICE_ID=rizurf-employees-api
PORT=3420
GATEWAY_URL=http://127.0.0.1:4301
PUBLIC_URL=http://127.0.0.1:3420

# Signs this app's own session cookie (HMAC). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# This app's one gateway-registered API client (client_credentials), granted
# access to every external audience below — the grant's `audience` param is
# what selects which service's token comes back, not a separate client per
# service. Set this once; only add a per-service CLIENT_ID/SECRET pair below
# if a service is ever split onto its own credential.
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=

# Applicants DB (external — Rizurf Recruitment API, real service id "recruitment-api").
APPLICANTS_API_BASE_URL=https://hr-recruitment-demo.vercel.app
APPLICANTS_SERVICE_ID=recruitment-api

# Interns DB (external, PostgreSQL/Supabase — real service id "intern-database").
INTERNS_API_BASE_URL=https://intern-database.vercel.app
INTERNS_SERVICE_ID=intern-database

# Department directory (external, API-only — real service id "department-api").
DEPARTMENTS_API_BASE_URL=https://department-zeta.vercel.app
DEPARTMENTS_SERVICE_ID=department-api

# Outbound email (server/messaging/emailProvider.js), sent via SMTP.
# secure/TLS is inferred from MAIL_PORT === 465 — set to 587 for STARTTLS instead.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Rizurf Onboarding Team

# Reading candidate replies from the same mailbox (server/messaging/imapReplyChecker.js).
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
